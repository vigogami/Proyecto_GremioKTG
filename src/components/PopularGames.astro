---
const { games = [] } = Astro.props
---
<section class="popular" aria-labelledby="popular-heading">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title" id="popular-heading">Juegos populares</h2>
      <p class="section-subtitle">
        Explora rápidamente las guías destacadas por la comunidad.
      </p>
    </div>
    <div class="popular-grid">
      {games.map((item) => (
        <article class="popular-card" data-body-bg={item.src}>
          <img src={item.src} alt={item.title} loading="lazy" />
          <div class="card-content">
            <h3>{item.title}</h3>
            <button type="button" data-open-link={item.link} aria-label={`Abrir ${item.title}`}>
              Ver guía
            </button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .popular {
    padding: 3.5rem 0;
  }

  .section-header {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .section-subtitle {
    color: var(--muted);
  }

  .popular-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .popular-card {
    background: var(--surface);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(9, 6, 15, 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    cursor: pointer;
  }

  .popular-card img {
    width: 100%;
    height: 140px;
    object-fit: cover;
  }

  .popular-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 24px 48px rgba(8, 5, 15, 0.45);
  }

  .card-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem 1.15rem;
  }

  .card-content h3 {
    font-size: 1rem;
    line-height: 1.3;
  }

  .card-content button {
    appearance: none;
    border: none;
    border-radius: 999px;
    padding: 0.45rem 1rem;
    background: rgba(255, 183, 77, 0.18);
    color: #ffd699;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .card-content button:hover,
  .card-content button:focus-visible {
    background: rgba(255, 183, 77, 0.32);
    color: white;
  }
</style>
